# Copy this file to .env.local and fill in the values from your Supabase project.
# Both .env and .env.local are ignored by git; never commit real values.
# Project settings -> Data API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Project settings -> API keys -> publishable key (safe for the browser, never the secret key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# The origin the app is served from. Must match the Supabase Site URL and the
# allowed redirects for /auth/callback and /auth/confirm. See docs/SETUP.md.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
